# ============================================================
# 로컬 개발용 환경변수 템플릿
#
# 사용법: 이 파일을 복사해 .env 를 만들고 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 로 제외되어 커밋되지 않는다.
#
# 여기 있는 값은 docker-compose.yml 의 ${VAR} 자리에 그대로 들어간다.
# 기본값이 없으므로 DB/CORS/JWT/카카오 OAuth 8개는 전부 채워야 컨테이너가 뜬다.
# 아래 외부 API 키 4개는 비어 있어도 기동은 성공하고, 해당 기능을 실제로 호출할 때
# 비로소 502가 난다 — 챗봇/장소/축제를 만질 거면 반드시 채울 것.
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_DB=ieumgil
POSTGRES_USER=ieumgil
POSTGRES_PASSWORD=changeme

# ---------- CORS ----------
# 프론트 개발 서버 주소. 여러 개면 콤마로 구분
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- JWT ----------
# HS256 서명 키. 반드시 32자 이상 (짧으면 앱 기동 시 예외 발생)
# 생성 예: openssl rand -base64 36
JWT_SECRET=

# ---------- 카카오 OAuth ----------
# 카카오 개발자센터 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_CLIENT_ID=
# 보안 > Client Secret. 사용 안 하면 빈 값으로 둔다
KAKAO_CLIENT_SECRET=
# 카카오 개발자센터에 등록한 Redirect URI (백엔드가 아니라 프론트 콜백 주소)
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao/callback

# ---------- 외부 API 키 ----------
# 카카오 개발자센터 > 내 애플리케이션 > 앱 키 > REST API 키.
# 장소 검색(카카오 로컬)과 도보·택시 길찾기(카카오모빌리티) 호출에 쓴다 — 로그인용과 용도가 다르다
KAKAO_REST_API_KEY=
# ODsay LAB(lab.odsay.com) > 마이페이지 > API 키. 대중교통 경로·시간표 조회에 쓴다
ODSAY_API_KEY=
# data.go.kr > 마이페이지 > 개발계정 상세 > 일반 인증키의 "Decoding" 값(원본, 특수문자 그대로).
# "Encoding" 값을 넣으면 클라이언트가 다시 인코딩해 이중 인코딩이 되고 401이 난다. 축제 정보(TourAPI)용
TOUR_API_KEY=
# SSAFY GMS(gms.ssafy.io)에서 발급받는 Claude API 키. 챗봇 응답 생성에 쓴다 (팀 공용 크레딧을 소모한다)
GMS_API_KEY=
